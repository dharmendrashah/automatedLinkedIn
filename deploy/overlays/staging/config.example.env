# Staging configuration, merged on top of deploy/base/config.env.
#
# Copy to config.env in this directory and fill it in. config.env is git-ignored:
# the whole file is stored in the GitHub secret STAGING_CONFIG_ENV and written back
# by .github/workflows/deploy-staging.yml.

APP_URL=https://app.staging.elitale.com
AUTHENTIK_ISSUER=https://auth.staging.elitale.com/application/o/automatedlinkedin/
CORS_ORIGINS=https://app.staging.elitale.com

# External PostgreSQL server (different cloud). The password lives in secrets.env.
AUTHENTIK_POSTGRESQL__HOST=CHANGE_ME.elitale.com
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
