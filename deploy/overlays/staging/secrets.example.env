# Copy to secrets.env in this directory and fill in real values.
# secrets.env is git-ignored - never commit it.
#
# Never reuse the public development defaults from docker-compose.yml / .env.example.
# Generate the authentik key with: openssl rand -base64 60 | tr -d '\n'

# Prisma connection string for brain and the migration init container.
# The database is external and reached without TLS by explicit decision
# (see .plan/kubernetes-deploy.md); restrict the server's firewall to the cluster egress IP.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/automatedlinkedin_staging?connection_limit=5

# authentik's own database on the same external server
AUTHENTIK_POSTGRESQL__PASSWORD=CHANGE_ME
AUTHENTIK_SECRET_KEY=CHANGE_ME
