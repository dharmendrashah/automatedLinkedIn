# Copy to secrets.env in this directory and fill in real values.
# secrets.env is git-ignored - never commit it.
#
# Never reuse the public development defaults from docker-compose.yml / .env.example.
# Generate the authentik key with: openssl rand -base64 60 | tr -d '\n'

# Prisma connection string for brain and the migration init container.
# The database is external and reached without TLS by explicit decision
# (see .plan/kubernetes-deploy.md); restrict the server's firewall to the cluster egress IP.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/automatedlinkedin_staging?connection_limit=5

# authentik's own database on the same external server
AUTHENTIK_POSTGRESQL__PASSWORD=CHANGE_ME
AUTHENTIK_SECRET_KEY=CHANGE_ME

# Resend API key, used as the SMTP password for authentik e-mail.
AUTHENTIK_EMAIL__PASSWORD=CHANGE_ME

# Base64 32-byte key (AES-256-GCM) encrypting stored LinkedIn secrets. Generate with: openssl rand -base64 32
# Changing it makes existing stored secrets undecryptable, so set it once and keep it.
LINKEDIN_CRED_ENC_KEY=CHANGE_ME

# ipinfo.io Lite API token, used to look up a proxy's country by routing a request through it.
IPINFO_TOKEN=CHANGE_ME

# AbuseIPDB API key for the daily proxy score. Optional: leave it empty and proxies are scored on latency alone.
ABUSEIPDB_API_KEY=

# Key of the shared data wallet for workflows. Only the brain worker uses it. Empty: collect steps fail as
# "not configured". Also add it to the STAGING_SECRETS_ENV GitHub secret, which CI writes this file from.
MINDCASE_API_KEY=

# RabbitMQ user and password. Letters and digits only (no @ : / %), because they are placed inside
# brain's RABBITMQ_URL. Generate the password with: openssl rand -hex 16
# They apply only when the broker's volume is first created; changing them later needs a new volume.
RABBITMQ_DEFAULT_USER=automatedlinkedin
RABBITMQ_DEFAULT_PASS=CHANGE_ME
