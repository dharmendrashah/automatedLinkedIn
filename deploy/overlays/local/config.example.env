# Local minikube configuration, merged on top of deploy/base/config.env.
#
# Copy to config.env in this directory (it is git-ignored, like every overlay's).
# These values are safe defaults for a local cluster; nothing here is secret.

APP_URL=http://app.automatedlinkedin.local
AUTHENTIK_ISSUER=http://auth.automatedlinkedin.local/application/o/automatedlinkedin/
CORS_ORIGINS=http://app.automatedlinkedin.local

# The docker compose PostgreSQL on the host. host.minikube.internal resolves to the
# host from inside the minikube node.
AUTHENTIK_POSTGRESQL__HOST=host.minikube.internal
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
