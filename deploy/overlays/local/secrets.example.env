# Copy to secrets.env in this directory. git-ignored like every overlay's.
#
# These are the public development credentials from docker-compose.yml. They are fine
# for a local cluster and must never be used anywhere else.

DATABASE_URL=postgresql://postgres:postgres@host.minikube.internal:5432/automatedlinkedin
AUTHENTIK_POSTGRESQL__PASSWORD=authentik
AUTHENTIK_SECRET_KEY=dev-only-change-me-dev-only-change-me-dev-only-change-me
LINKEDIN_CRED_ENC_KEY=pqaZGClH/kqxNTLoLT4c0lMTloNIi2At3Jzz9a2rkIQ=
IPINFO_TOKEN=dev-ipinfo-token
ABUSEIPDB_API_KEY=
# Shared data wallet key for workflows; empty: collect steps fail as "not configured".
MINDCASE_API_KEY=

# RabbitMQ user and password (URL-safe: they are placed inside brain's RABBITMQ_URL). Dev values.
RABBITMQ_DEFAULT_USER=automatedlinkedin
RABBITMQ_DEFAULT_PASS=automatedlinkedin
