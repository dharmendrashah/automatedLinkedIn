# Settings for apps/spider that do not change between environments. Cloud or account specific values
# (SPIDER_GCS_BUCKET, SPIDER_ALLOWED_HOSTS, SPIDER_ROBOTS_EXEMPT_HOSTS) live in the overlay that includes
# this component instead, next to its own config.env.
SPIDER_MIN_DELAY_MS=2000
SPIDER_MAX_RECORDS=200
SPIDER_ACTION_TIMEOUT_MS=30000
SPIDER_ROBOTS_USER_AGENT=automatedlinkedin-spider
SPIDER_ACCOUNT_LOCK_TTL_MS=300000
SPIDER_ACCOUNT_BUSY_DELAY_MS=10000
# full: try the saved browser token, then the password (and a two-step code). See .plan/account-validation.md.
SPIDER_VALIDATION_MODE=full
SPIDER_LINKEDIN_BASE_URL=https://www.linkedin.com
