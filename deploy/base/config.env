# Non-secret configuration shared by every environment.
# Overlays merge their own config.env on top of this file.

# Browser-facing URLs (no trailing slash on APP_URL)
APP_URL=http://localhost:3000

# brain
NODE_ENV=production
PORT=3001
AUTHENTIK_ISSUER=http://localhost:9000/application/o/automatedlinkedin/
AUTHENTIK_CLIENT_ID=automatedlinkedin
AUTHENTIK_INTERNAL_URL=http://authentik-server:9000
CORS_ORIGINS=http://localhost:3000

# authentik -> external PostgreSQL server
AUTHENTIK_POSTGRESQL__HOST=postgres.example.invalid
AUTHENTIK_POSTGRESQL__PORT=5432
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
# No TLS to the database by explicit decision (see .plan/kubernetes-deploy.md)
AUTHENTIK_POSTGRESQL__SSLMODE=disable
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true
AUTHENTIK_ERROR_REPORTING__ENABLED=false
