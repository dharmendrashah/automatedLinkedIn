{
   "name": "@automatedLinkedIn/logger",
   "version": "1.0.0",
   "private": true,
   "sideEffects": false,
   "main": "dist/index.js",
   "types": "src/index.ts",
   "exports": {
      ".": {
         "types": "./src/index.ts",
         "import": "./dist/index.mjs",
         "require": "./dist/index.js"
      },
      "./browser": {
         "types": "./src/browser.ts",
         "import": "./dist/browser.mjs",
         "require": "./dist/browser.js"
      }
   },
   "files": ["dist"],
   "scripts": {
      "dev": "pnpm build:lib --watch",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix",
      "ts:check": "tsc -b",
      "check": "pnpm lint && pnpm ts:check",
      "build:lib": "tsup src/index.ts src/browser.ts --format cjs,esm",
      "test:unit": "vitest .unit.test.ts",
      "test:unit:run": "pnpm test:unit --run"
   },
   "dependencies": {
      "pino": "^10.4.0"
   },
   "devDependencies": {
      "@automatedLinkedIn/contracts": "workspace:*",
      "@automatedLinkedIn/eslint-config": "workspace:*",
      "@automatedLinkedIn/tsconfig": "workspace:*",
      "@types/node": "^26.6.4",
      "tsup": "^8.5.1",
      "typescript": "^7.0.2"
   }
}
