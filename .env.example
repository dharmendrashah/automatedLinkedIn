# Used by docker compose. Copy to .env (never commit .env) and uncomment what you want to change.
# The defaults are for local development only; set real values for anything shared.

# authentik (identity provider), UI at http://localhost:9000
# authentik shares the main postgres service; AUTHENTIK_PG_* name its own database and role there.
# Generate values with: openssl rand -base64 36 | tr -d '\n'   (secret key: openssl rand -base64 60 | tr -d '\n')
# AUTHENTIK_SECRET_KEY=
# AUTHENTIK_PG_PASS=
# AUTHENTIK_PG_USER=authentik
# AUTHENTIK_PG_DB=authentik
# Sets the akadmin password on first start. Without it, open http://localhost:9000/if/flow/initial-setup/
# AUTHENTIK_BOOTSTRAP_PASSWORD=
# AUTHENTIK_BOOTSTRAP_EMAIL=admin@elitale.com

# RabbitMQ broker, UI at http://localhost:15672. The user, password and vhost are created on first start
# of the broker's volume; changing them later needs a new `rabbitmq-data` volume. Keep the password
# URL-safe (letters and digits): it is placed inside brain's RABBITMQ_URL.
# RABBITMQ_DEFAULT_USER=automatedlinkedin
# RABBITMQ_DEFAULT_PASS=automatedlinkedin
# RABBITMQ_DEFAULT_VHOST=automatedlinkedin

# The platform owner: the user with this verified email gets the ADMIN role (cron monitor, usage owner view).
# ADMIN_EMAIL=owner@example.com

# Frontend build settings (apps/body). Override for a deployed authentik or API.
# VITE_API_URL=http://localhost:3001
# VITE_AUTHENTIK_URL=http://localhost:9000
# VITE_AUTHENTIK_CLIENT_ID=automatedlinkedin
# VITE_AUTHENTIK_APP_SLUG=automatedlinkedin
# VITE_AUTHENTIK_ENROLLMENT_SLUG=automatedlinkedin-enrollment

# Outbound e-mail for sign-up verification and password reset.
# By default authentik sends to the local Mailpit catcher, UI at http://localhost:8025.
# To send real mail through Resend, uncomment these and set the API key:
# AUTHENTIK_EMAIL__HOST=smtp.resend.com
# AUTHENTIK_EMAIL__PORT=465
# AUTHENTIK_EMAIL__USERNAME=resend
# AUTHENTIK_EMAIL__PASSWORD=
# AUTHENTIK_EMAIL__USE_SSL=true
# AUTHENTIK_EMAIL__USE_TLS=false
# AUTHENTIK_EMAIL__FROM=no-reply@your-verified-domain.com
