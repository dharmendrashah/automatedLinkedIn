{
   "name": "@automatedLinkedIn/spider",
   "private": true,
   "version": "0.0.0",
   "scripts": {
      "dev": "tsx watch src/server.ts",
      "dev:worker": "tsx watch src/worker.ts",
      "build": "tsc -b",
      "start": "node dist/src/server.js",
      "start:worker": "node dist/src/worker.js",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix",
      "ts:check": "tsc -b",
      "check": "pnpm lint && pnpm ts:check",
      "test:unit": "vitest .unit.test.ts",
      "test:unit:run": "pnpm test:unit --run",
      "test:integration": "vitest .integration.test.ts",
      "test:integration:run": "pnpm test:integration --run",
      "test:e2e": "vitest .e2e.test.ts",
      "test:e2e:run": "pnpm test:e2e --run"
   },
   "devDependencies": {
      "@automatedLinkedIn/eslint-config": "workspace:*",
      "@automatedLinkedIn/tsconfig": "workspace:*",
      "@types/node": "^26.6.4",
      "tsx": "^4.23.15",
      "typescript": "^7.0.2"
   },
   "dependencies": {
      "@automatedLinkedIn/contracts": "workspace:*",
      "@google-cloud/storage": "^8.4.0",
      "amqplib": "^2.2.0",
      "camoufox": "0.5.8",
      "dotenv": "^18.0.7",
      "envalid": "^8.2.0",
      "fastify": "^5.12.5",
      "fingerprint-generator": "^2.1.88",
      "playwright-core": "1.62.0",
      "robots-parser": "^3.0.1",
      "zod": "^4.6.5"
   }
}
