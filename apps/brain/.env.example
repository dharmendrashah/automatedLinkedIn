NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/automatedlinkedin

# Base64 32-byte key (AES-256-GCM) that encrypts stored LinkedIn secrets at rest.
# Generate with: openssl rand -base64 32
# Dev/test fall back to an insecure built-in key; production has no default and must set this.
# LINKEDIN_CRED_ENC_KEY=

# ipinfo.io Lite API token, used to look up a proxy's country by routing a request through it.
# Dev/test fall back to a placeholder (no real lookups happen); production has no default and must set this.
# IPINFO_TOKEN=

# AMQP URL of the RabbitMQ broker (vhost in the path). The default matches the docker compose broker:
# `docker compose up -d rabbitmq`, UI at http://localhost:15672. Production has no default.
# RABBITMQ_URL=amqp://automatedlinkedin:automatedlinkedin@localhost:5672/automatedlinkedin

# Access tokens are verified against authentik (defaults shown). Set AUTHENTIK_INTERNAL_URL when brain reaches
# authentik on a different host than the browser does, for example http://authentik-server:9000 in Docker.
# AUTHENTIK_ISSUER=http://localhost:9000/application/o/automatedlinkedin/
# AUTHENTIK_CLIENT_ID=automatedlinkedin
# AUTHENTIK_INTERNAL_URL=
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# The Sessions page plays a recording straight from this bucket through short-lived signed links, so brain needs
# credentials that can sign: Application Default Credentials from a service account (Workload Identity on GKE, or
# `gcloud auth application-default login --impersonate-service-account=<service account>` locally). Your own user
# credentials cannot sign. Empty: the page works, but without recordings. See deploy/gcp-setup.md.
# SPIDER_GCS_BUCKET=automate-linkedin-511215-spider
# Match the lifecycle rule that deletes recordings/ from the bucket.
# SESSION_RECORDING_RETENTION_DAYS=7

# Service status page (/healthstatus): where brain asks whether each module is live. The defaults are the Kubernetes
# and Docker Compose service names; a local `pnpm dev` run uses localhost ports. An empty value leaves that module out.
# STATUS_URL_WEBSITE=http://body:80/health
# STATUS_URL_SIGN_IN=http://authentik-server:9000/-/health/ready/
# STATUS_URL_SPIDER_API=http://spider-api:3002/health
# STATUS_URL_SPIDER_WORKER=http://spider-worker:3003/health
# authentik's worker has no web address: brain asks Kubernetes about this deployment (Unknown outside Kubernetes).
# STATUS_AUTHENTIK_WORKER_DEPLOYMENT=authentik-worker
# The mail server authentik uses; brain only connects and reads its greeting. Empty host: no Email module.
# AUTHENTIK_EMAIL__HOST=
# AUTHENTIK_EMAIL__PORT=465
# AUTHENTIK_EMAIL__USE_SSL=false
