generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id          String    @id @default(uuid(7))
  email       String    @unique
  name        String?
  role        Role      @default(USER)
  // Subject (`sub`) of the authentik account linked to this user.
  authentikId String?   @unique
  // When the owner last left the leads inbox; people added after it are marked new.
  inboxSeenAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  linkedInAccounts  LinkedInAccount[]
  linkedInCompanies LinkedInCompany[]
  linkedInPosts     LinkedInPost[]
  linkedInProfiles  LinkedInProfile[]
  spiderSessions    SpiderSession[]
  conversations     LinkedInConversation[]
  replies           LinkedInReply[]
  invitations       LinkedInInvitation[]
  sentInvites       LinkedInInvite[]
  connections       LinkedInConnection[]
  accountProfiles   LinkedInAccountProfile[]
  firstDaysUsed     FirstDayUsed[]
  profileVisits     LinkedInPageVisit[]
  postDrafts        PostDraft[]
  postPublications  PostPublication[]
  workflowLists     WorkflowList[]
  suppressions      Suppression[]
  personSnapshots   PersonSnapshot[]
  pageSnapshots     PageSnapshot[]
  dataReads         DataRead[]
  icps              Icp[]
  companyViews      CompanyView[]
  workflows         Workflow[]
  clients           Client[]
  people            Person[]
}

enum WorkflowListMemberState {
  QUALIFIED
  MAYBE
  // Added by a workflow without a Score block.
  UNSCORED
}

enum WorkflowListMemberStatus {
  NEW
  // No longer set: moved to NEW and CONTACTED by migration add_inbox_statuses_backfill.
  IN_REVIEW
  DONE
  NOT_A_FIT
  CONTACTED
  REPLIED
}

// A named list of people found by hand or by a workflow; separate from the target profiles.
model WorkflowList {
  id        String               @id @default(uuid(7))
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // The client its people belong to on My network; null is the owner's default client.
  clientId  String?
  client    Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   WorkflowListMember[]
  workflows Workflow[]

  @@unique([userId, name])
}

// Only the minimal person fields are kept; a person is in at most one of the owner's lists.
model WorkflowListMember {
  id           String                   @id @default(uuid(7))
  listId       String
  list         WorkflowList             @relation(fields: [listId], references: [id], onDelete: Cascade)
  slug         String
  url          String
  name         String?
  headline     String?
  location     String?
  state        WorkflowListMemberState  @default(QUALIFIED)
  status       WorkflowListMemberStatus @default(NEW)
  // When the owner marked them contacted; cleared when they go back to New or Not a fit.
  contactedAt  DateTime?
  // The post that surfaced the person; null when added by hand.
  postUrl      String?
  // Set when a workflow added the person: the score, why they were found, and the run.
  score        Int?
  signals      Json?
  addedByRunId String?
  // From the run that added the person: current role, followers and the ideal-customer rules they matched.
  title        String?
  company      String?
  followers    Int?
  matched      String[]
  notes        String?
  tags         String[]
  // Set when the person was not touched for 180 days; deleted 30 days later unless touched or kept.
  reviewAt     DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([listId, slug])
  @@index([listId, state, createdAt])
  @@index([slug])
  @@index([postUrl])
}

// People the owner must never contact or add again; profile slugs only.
model Suppression {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String
  createdAt DateTime @default(now())

  @@unique([userId, slug])
}

// A full profile the owner chose to read ("Read full profile"), allow-listed fields only. Kept while the person is in
// one of the owner's lists or in /profiles; deleted with "Do not contact".
model PersonSnapshot {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String
  data      Json
  fetchedAt DateTime @default(now())

  @@unique([userId, slug])
}

enum PageKind {
  COMPANY
  POST
  // A post's comments or reactions, under the post's slug.
  POST_COMMENTS
  POST_REACTIONS
}

// A company page or post the owner chose to read, allow-listed fields only. Kept while it is in /companies or /posts
// and not archived.
model PageSnapshot {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      PageKind
  slug      String
  data      Json
  fetchedAt DateTime @default(now())

  @@unique([userId, kind, slug])
}

enum DataReadKind {
  PROFILE
  COMPANY
  POST
  COMMENTS
  REACTIONS
}

enum DataReadStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// A paid read the owner asked for in a drawer, done by the brain worker: started, looked at, retried when it failed
// without a charge, then stored as a snapshot. Never returned to the browser beyond its status and message.
model DataRead {
  id         String         @id @default(uuid(7))
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       DataReadKind
  slug       String
  // Tells reads of one item apart, such as the first 100 comments and all of them.
  variant    String         @default("")
  operation  String
  params     Json
  status     DataReadStatus @default(QUEUED)
  // `userId:kind:slug:variant` while queued or running, null after; one read of an item at a time.
  activeKey  String?        @unique
  jobId      String?
  sentAt     DateTime?
  attempts   Int            @default(0)
  retryAt    DateTime       @default(now())
  // When a worker took it; a read held too long is taken again.
  claimedAt  DateTime?
  costMicros Int            @default(0)
  // The sentence the owner reads when it failed.
  message    String?
  // The client of the person or company it was read for, so its cost is booked to that client.
  clientId   String?
  createdAt  DateTime       @default(now())
  finishedAt DateTime?

  @@index([status, retryAt])
  @@index([userId, kind, slug])
}

enum WorkflowTrigger {
  MANUAL
  SCHEDULE
  PREVIEW
  API
  WORKFLOW
}

enum WorkflowRunStatus {
  // Saved while another run of the workflow was live; the engine starts the oldest when that run ended.
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  // Stopped by the owner, after the requests already paid for finished.
  STOPPED
}

enum WorkflowStepStatus {
  WAITING
  RUNNING
  DONE
  PARTIAL
  FAILED
  // Never started: the run was stopped, or another block failed, first.
  SKIPPED
}

// A graph of catalog blocks (packages/contracts workflow.ts) that finds people and adds them to its output list.
model Workflow {
  id           String            @id @default(uuid(7))
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  goal         String?
  graph        Json
  // A list in use by a workflow cannot be deleted.
  outputListId String
  outputList   WorkflowList      @relation(fields: [outputListId], references: [id], onDelete: Restrict)
  qualifyScore Int               @default(60)
  maybeScore   Int               @default(40)
  maybeEnabled Boolean           @default(true)
  // Switched on: a schedule, API or chained workflow may start it; nextRunAt is when the schedule job starts it next.
  enabled      Boolean           @default(false)
  nextRunAt    DateTime?
  // SHA-256 of the API token; the token itself is shown once.
  apiTokenHash String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  runs         WorkflowRun[]
  versions     WorkflowVersion[]

  @@unique([userId, name])
  @@index([enabled, nextRunAt])
}

// A saved version of a workflow's graph: one for each save that changed it, the newest 50 kept
// (.plan/workflow-engine-p5-editor.md).
model WorkflowVersion {
  id         String   @id @default(uuid(7))
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  graph      Json
  createdAt  DateTime @default(now())

  @@index([workflowId, createdAt])
}

// One execution. It keeps a copy of the graph it started with, so editing the workflow never changes it.
model WorkflowRun {
  id               String            @id @default(uuid(7))
  workflowId       String
  workflow         Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  userId           String
  trigger          WorkflowTrigger
  // Unique per start, so a repeated schedule tick or a double click cannot start the same run twice.
  runKey           String            @unique
  status           WorkflowRunStatus @default(RUNNING)
  graph            Json
  qualifyScore     Int
  maybeScore       Int
  maybeEnabled     Boolean
  estimateMicros   Int               @default(0)
  costMicros       Int               @default(0)
  qualified        Int               @default(0)
  maybe            Int               @default(0)
  discarded        Int               @default(0)
  // Links sent by an API call, or the people a finished workflow passed on.
  input            Json?
  // How many workflows started this one in a chain.
  depth            Int               @default(0)
  // 1: every block runs (runs from before 2026-11-02). 2: a block runs only when something reaches it, and only the triggers
  // that fired start the run (.plan/workflow-engine-p2-run-semantics.md).
  engineVersion    Int               @default(1)
  // The run whose "Run another workflow" block started this one.
  parentRunId      String?
  // Set when the owner asked to stop: nothing new starts, and the run ends as STOPPED once paid jobs finished.
  stopRequestedAt  DateTime?
  message          String?
  // Set when the owner dismissed the alert about this run failing (.plan/workflow-engine-p4-lifecycle.md).
  alertDismissedAt DateTime?
  startedAt        DateTime          @default(now())
  finishedAt       DateTime?
  steps            WorkflowStepRun[]
  items            WorkflowItem[]

  // One run going at a time: a partial unique index on (workflowId) where status is RUNNING, in the migration
  // workflow_run_one_live (Prisma cannot express it).
  @@index([workflowId, startedAt])
  @@index([status])
  @@index([parentRunId])
}

model WorkflowStepRun {
  id         String             @id @default(uuid(7))
  runId      String
  run        WorkflowRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId     String
  type       String
  status     WorkflowStepStatus @default(WAITING)
  itemsIn    Int                @default(0)
  itemsOut   Int                @default(0)
  costMicros Int                @default(0)
  message    String?
  // Why the step failed or ended with gaps (STEP_ERROR_CODES in the contracts package); null for steps from before codes.
  errorCode  String?
  // Which repeat of a loop or For each batch this is; 0 for blocks that run once.
  round      Int                @default(0)
  // When a worker took the step; a step held too long is taken again.
  claimedAt  DateTime?
  // The run a "Run another workflow" step started.
  childRunId String?
  // The step does not start before this time: set by Wait, and by Retry for the pause before a new try (.plan/logic-wait-result-retry.md).
  waitUntil  DateTime?
  // How many times a Retry has run this step again.
  tries      Int                @default(0)
  // The outputs that gave something when the step ended (main, else); the blocks after it run only for a live one.
  emits      String[]           @default([])
  // When a worker first took the step; the time limits of a waiting step count from here (.plan/visit-block-waiting-reasons.md).
  startedAt  DateTime?
  finishedAt DateTime?
  calls      WorkflowStepCall[]

  @@unique([runId, nodeId, round])
}

// One paid request of a collect step. The supplier's job id is saved as soon as it is known, so a restart reads that
// job again instead of paying for a new one. Never returned to the browser.
model WorkflowStepCall {
  id         String          @id @default(uuid(7))
  stepRunId  String
  stepRun    WorkflowStepRun @relation(fields: [stepRunId], references: [id], onDelete: Cascade)
  inputKey   String
  jobId      String?
  status     String          @default("STARTED")
  rows       Int             @default(0)
  costMicros Int             @default(0)
  error      String?
  // Failed attempts so far; one that failed without a charge is sent again at retryAt.
  attempts   Int             @default(0)
  retryAt    DateTime?
  // Set just before the start is sent, so a start whose answer was lost is looked up instead of sent again.
  sentAt     DateTime?
  createdAt  DateTime        @default(now())
  finishedAt DateTime?

  @@unique([stepRunId, inputKey])
}

// What a step produced. Raw personal data, so it is deleted with the run data after 14 days.
model WorkflowItem {
  id        String      @id @default(uuid(7))
  runId     String
  run       WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId    String
  round     Int         @default(0)
  // person, post or company: a person and a company may share a slug.
  kind      String
  slug      String
  data      Json
  // Set for what reached an "Export to CSV" block: kept until then instead of 14 days.
  keepUntil DateTime?
  createdAt DateTime    @default(now())

  @@unique([runId, nodeId, round, kind, slug])
  @@index([createdAt])
}

// One row per finished paid request: what the data cost, per client and month (UTC). Amounts only.
model SpendLedger {
  id           String   @id @default(uuid(7))
  userId       String
  workflowId   String?
  runId        String?
  callId       String   @unique
  amountMicros Int
  // Names spend outside a workflow on the statement, such as "Company reads".
  label        String?
  // Calendar month in UTC, such as 2026-10.
  month        String
  // The client the spend is booked to; null when it was not made for one client (a workflow run).
  clientId     String?
  createdAt    DateTime @default(now())

  @@index([userId, month])
  @@index([month])
  @@index([clientId, month])
}

// The shared data wallet as the worker last saw it. One row.
model DataWallet {
  id            String   @id
  balanceMicros Int
  checkedAt     DateTime
}

// An ideal customer: the rules a person is scored against.
model Icp {
  id              String   @id @default(uuid(7))
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  includeTitles   String[]
  excludeTitles   String[]
  seniorities     String[]
  industries      String[]
  companySizes    String[]
  locations       String[]
  problemKeywords String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, name])
}

enum LinkedInPostStatus {
  UNPROCESSED
  PROCESSED
}

// A post the user wants to work through, saved from a pasted post link. The link is all that is kept.
model LinkedInPost {
  id          String             @id @default(uuid(7))
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // `<type>-<numeric id>` of the post (activity, share or ugcpost); unique per owner.
  slug        String
  url         String
  // For a lnkd.in short link: the linkedin.com post it redirects to, without its query string.
  expandedUrl String?
  status      LinkedInPostStatus @default(UNPROCESSED)
  tags        String[]           @default([])
  // No longer set: posts cannot be archived since 2026-11-01 (migration restore_archived_posts brought them back).
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([userId, slug])
  @@index([userId, archivedAt, createdAt])
}

enum LinkedInCompanyStatus {
  NEW
  CONTACTED
  REPLIED
}

// A company the user wants to reach, saved from a pasted company link. Nothing here is scraped.
model LinkedInCompany {
  id         String                @id @default(uuid(7))
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Lowercase public identifier from linkedin.com/company/<slug>; unique per owner.
  slug       String
  url        String
  name       String?
  industry   String?
  website    String?
  size       String?
  location   String?
  // From the latest company read (.plan/companies-table.md); filters and sorts the Companies table.
  country    String?
  notes      String?
  tags       String[]
  status     LinkedInCompanyStatus @default(NEW)
  // Set when the owner removes the company; it can be restored.
  archivedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  visits LinkedInPageVisit[]

  @@unique([userId, slug])
  @@index([userId, archivedAt, createdAt])
  @@index([userId, country])
  @@index([userId, industry])
}

// A named set of Companies filters the owner saved (.plan/companies-filter-drawer.md): the page's address query, applied as it is.
model CompanyView {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

enum LinkedInProfileStatus {
  NEW
  CONTACTED
  REPLIED
}

// A person the user wants to reach, saved from a pasted profile link. Nothing here is scraped.
model LinkedInProfile {
  id         String                @id @default(uuid(7))
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Lowercase public identifier from linkedin.com/in/<slug>; unique per owner.
  slug       String
  url        String
  fullName   String?
  headline   String?
  company    String?
  location   String?
  notes      String?
  tags       String[]
  status     LinkedInProfileStatus @default(NEW)
  // Set when the owner removes the profile; it can be restored.
  archivedAt DateTime?
  // The client the target belongs to on My network; null is the owner's default client.
  clientId   String?
  client     Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  visits LinkedInPageVisit[]

  @@unique([userId, slug])
  @@index([userId, archivedAt, createdAt])
}

enum PageVisitStatus {
  // Asked for; the run is going or its answer has not come yet.
  ASKED
  DONE
  // The address did not lead to a page that could be viewed.
  NOT_AVAILABLE
  FAILED

  @@map("ProfileVisitStatus")
}

enum PageVisitKind {
  PROFILE
  COMPANY
}

// One visit of one of the owner's accounts to a profile or a company page (.plan/visit-profile-task.md, .plan/visit-company-task.md):
// the record the daily cap and the "never twice in 30 days" rule are counted from. It keeps the public address slug the owner asked
// for and nothing of the page. The table kept its first name, `LinkedInProfileVisit`.
model LinkedInPageVisit {
  id         String           @id @default(uuid(7))
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String
  account    LinkedInAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind       PageVisitKind    @default(PROFILE)
  // The saved profile or company it was asked from; null for a pasted link, or once the saved one is deleted.
  profileId  String?
  profile    LinkedInProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  companyId  String?
  company    LinkedInCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  slug       String
  // The run; no relation, because the run's row is deleted after 30 days and the record must outlive it.
  sessionId  String           @unique
  // The workflow run and block that asked for it (.plan/select-accounts-block.md); null for a visit asked by hand. No relation, like the session.
  runId      String?
  nodeId     String?
  status     PageVisitStatus  @default(ASKED)
  createdAt  DateTime         @default(now())
  finishedAt DateTime?

  @@index([runId, nodeId])
  @@index([accountId, createdAt])
  @@index([accountId, slug])
  @@index([profileId])
  @@index([companyId])
  @@map("LinkedInProfileVisit")
}

enum LinkedInAccountStatus {
  // Stored but not verified against LinkedIn yet.
  PENDING
  ACTIVE
  NEEDS_REAUTH
  ERROR
  // Paused by the owner; automation must skip it.
  DISABLED
  // LinkedIn restricted the account; only the owner can lift that on LinkedIn.
  BLOCKED
}

// A LinkedIn login the user asks the tool to act as. Secrets live in one AES-256-GCM
// encrypted JSON bundle ({ password?, totpSecret?, session? }); the booleans mirror which
// secrets are set so metadata reads never decrypt.
model LinkedInAccount {
  id                    String                @id @default(uuid(7))
  userId                String
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                 String
  secret                String
  secretIv              String
  secretTag             String
  keyVersion            Int                   @default(1)
  hasPassword           Boolean               @default(false)
  hasTotp               Boolean               @default(false)
  hasSession            Boolean               @default(false)
  status                LinkedInAccountStatus @default(PENDING)
  // Short, non-secret reason for the current status.
  statusMessage         String?
  statusUpdatedAt       DateTime              @default(now())
  lastVerifiedAt        DateTime?
  // Id of the validation the account is waiting for. A result from the worker applies only if it carries this id.
  validationId          String?
  validationRequestedAt DateTime?
  // When the daily sign-in check and the daily visit run next: a random time each day (.plan/account-daily-check.md).
  nextCheckAt           DateTime?
  nextBrowseAt          DateTime?
  // The daily automatic read of the account's messages, at a random time of its day (.plan/unibox-backend.md).
  nextMessagesAt        DateTime?
  // The daily automatic read of the connection requests, at a random time of the account's day (.plan/my-network-daily-read.md).
  nextInvitationsAt     DateTime?
  // A new account's first reads (.plan/first-day-reads.md): when its first sign-in was good (the first day's reads may start outside
  // working hours for 24 hours after it), when the next first-day read may be asked, and when connections (weekly) and the own
  // profile (monthly) are read again.
  firstSignedInAt       DateTime?
  nextFirstReadAt       DateTime?
  nextConnectionsAt     DateTime?
  nextProfileAt         DateTime?
  // The name and picture LinkedIn showed for the account when its messages were last read; shown in the Unibox.
  displayName           String?
  imageUrl              String?
  messagesReadAt        DateTime?
  // When the whole inbox had been read once; null while that first read is still going (.plan/messages-first-sync-and-new-only.md).
  messagesBackfilledAt  DateTime?
  // The last time the newest conversations were read whatever their rows said, to find a change the rows did not show.
  messagesSweptAt       DateTime?
  // Where the next read goes on after a batch that did not finish (the first read, or a read of many changes); null when nothing
  // is pending (.plan/messages-resume.md). `messagesResumeUntil` is not used any more: the read says itself when it is finished.
  messagesResumeSkip    Int?
  messagesResumeUntil   Int?
  // When the connection requests the account received were last read, and how many LinkedIn said wait (.plan/my-network-invitations.md).
  invitationsReadAt     DateTime?
  invitationsTotal      Int?
  // When the connections of the account were last read, and how many LinkedIn said it has (.plan/my-connections.md).
  connectionsReadAt     DateTime?
  connectionsTotal      Int?
  // When the profile was first asked for (by the first visit of the page or the button); null means "never asked", which is
  // what lets the first visit start the read once (.plan/account-profile-backend.md).
  profileAskedAt        DateTime?
  // How much the account may browse in a day, and when (.plan/account-browsing-budget.md). Office days are bits, Monday is bit 0
  // (31 is Monday to Friday); minutes are after midnight in `officeTimeZone`, or in the zone of the proxy's country when null.
  browseMode            BrowseMode            @default(SAFE)
  officeTimeZone        String?
  officeDays            Int                   @default(31)
  officeStartMinute     Int                   @default(540)
  officeEndMinute       Int                   @default(1080)
  // The owner's own note on who the account works for; changes no limit.
  clientLabel           String?
  // The client the account works for (one client per account); null is the owner's default client.
  clientId              String?
  client                Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Invites stopped by trouble (.plan/network-invites.md): when, why, and until when; with no end they wait for the next good
  // sign-in after `invitesStoppedAt`. `nextAcceptReadAt` is the daily read of the newest connections while invites are pending.
  invitesStoppedAt      DateTime?
  invitesStopReason     String?
  invitesStopUntil      DateTime?
  // The account used its free invite notes this month (.plan/invite-note-fallback.md): until then invites go without their note.
  notesOutUntil         DateTime?
  nextAcceptReadAt      DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  proxyServers     ProxyServer[]
  browseUsage      BrowseUsage[]
  spiderSessions   SpiderSession[]
  conversations    LinkedInConversation[]
  replies          LinkedInReply[]
  invitations      LinkedInInvitation[]
  sentInvites      LinkedInInvite[]
  connections      LinkedInConnection[]
  profile          LinkedInAccountProfile?
  profileVisits    LinkedInPageVisit[]
  postDrafts       PostDraft[]
  postPublications PostPublication[]
  personLinks      PersonLink[]

  @@unique([userId, email])
  @@index([userId])
}

enum BrowseMode {
  SAFE
  MODERATE
  AGGRESSIVE
}

enum BrowseClass {
  ACTION
  BACKGROUND
  SYSTEM
}

// ESTIMATED: the task's own guess while it runs, or the run's wall time when the worker did not say; MEASURED: how long the
// browser stayed open; NONE: the browser never opened.
enum BrowseSource {
  ESTIMATED
  MEASURED
  NONE
}

// The browser time of one session, booked to the account (.plan/account-browsing-budget.md). Reserved at its estimate when the
// session is asked for and settled when it ends. Not tied to the session row, which is deleted after 30 days; usage is kept
// 13 months.
model BrowseUsage {
  sessionId         String          @id
  linkedInAccountId String
  linkedInAccount   LinkedInAccount @relation(fields: [linkedInAccountId], references: [id], onDelete: Cascade)
  // The calendar day in the account's zone when it was asked for.
  day               String
  class             BrowseClass
  seconds           Int
  source            BrowseSource    @default(ESTIMATED)
  startedAt         DateTime        @default(now())
  settledAt         DateTime?

  @@index([linkedInAccountId, day])
}

enum ProxyProtocol {
  HTTP
  HTTPS
  SOCKS4
  SOCKS5
}

enum ProxyServerStatus {
  // Added but not tested yet (should not normally be visible; a create always tests first).
  PENDING
  ACTIVE
  // Reachable, but its country does not match the account's other proxies.
  GEO_MISMATCH
  UNREACHABLE
  // Paused by the owner; automation must skip it.
  DISABLED
}

// A proxy a LinkedIn account's sessions always go through. Belongs to exactly one account: reusing an IP
// across accounts is itself a correlation risk. Credentials live in one AES-256-GCM bundle, same shape as
// LinkedInAccount's, so CryptoService.seal/open is reused as is.
model ProxyServer {
  id                  String            @id @default(uuid(7))
  linkedInAccountId   String
  linkedInAccount     LinkedInAccount   @relation(fields: [linkedInAccountId], references: [id], onDelete: Cascade)
  protocol            ProxyProtocol
  host                String
  port                Int
  // Sealed { username?, password? }; both optional, some proxies need neither.
  secret              String
  secretIv            String
  secretTag           String
  keyVersion          Int               @default(1)
  status              ProxyServerStatus @default(PENDING)
  // Short, non-secret reason for the current status.
  statusMessage       String?
  lastTestedAt        DateTime?
  // How long the last successful test took, in milliseconds; null when the proxy could not be reached.
  latencyMs           Int?
  detectedCountryCode String?
  detectedCountry     String?
  detectedIp          String?
  // Preferred proxy for the account when more than one is ACTIVE; app-enforced, not a DB constraint.
  isPrimary           Boolean           @default(false)
  // 0 to 100, higher is better (.plan/proxy-ip-reputation.md): 70% IP reputation, 30% speed. Null when the proxy cannot be
  // scored (unreachable, no test yet). Without a reputation answer it is the speed alone and never above 89.
  score               Int?
  scoredAt            DateTime?
  // False when the score has no reputation behind it (no AbuseIPDB key, or the lookup failed).
  scoreHasReputation  Boolean?
  // AbuseIPDB's answer for abuseIp, the address that was checked. Kept for a day and reused while the IP stays the same.
  abuseIp             String?
  abuseScore          Int?
  abuseReports        Int?
  abuseLastReportedAt DateTime?
  abuseUsageType      String?
  abuseIsp            String?
  abuseIsTor          Boolean?
  abuseCheckedAt      DateTime?
  // What explains abuseScore (reasons, recent reports, reporters); see AbuseDetail in core. No report comments.
  abuseDetail         Json?
  // Short fixed reason the last lookup failed; null after a good one.
  abuseError          String?
  // Problems the owner chose to live with (HealthIssue codes), and when. A different problem asks again.
  riskAcceptedIssues  String[]          @default([])
  riskAcceptedAt      DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tests          ProxyTest[]
  scores         ProxyScore[]
  spiderSessions SpiderSession[]

  @@index([linkedInAccountId])
  @@index([scoredAt])
}

// One scoring of a proxy, kept for 30 days. No secrets: only the address that was checked and the numbers.
model ProxyScore {
  id                String            @id @default(uuid(7))
  proxyServerId     String
  proxyServer       ProxyServer       @relation(fields: [proxyServerId], references: [id], onDelete: Cascade)
  scoredAt          DateTime          @default(now())
  ip                String
  score             Int
  // Null when reputation was not checked.
  abuseScore        Int?
  latencyMs         Int?
  reputationChecked Boolean
  // The AbuseDetail known when this score was made; null for entries saved before details were kept.
  detail            Json?
  status            ProxyServerStatus

  @@index([proxyServerId, scoredAt])
  @@index([scoredAt])
}

// One run of the proxy test with exactly what was sent and what came back, kept for 7 days. Secrets are masked
// before they get here (see IpInfoService); the proxy's own credentials are never part of it.
model ProxyTest {
  id                String            @id @default(uuid(7))
  proxyServerId     String
  proxyServer       ProxyServer       @relation(fields: [proxyServerId], references: [id], onDelete: Cascade)
  testedAt          DateTime          @default(now())
  // The status the proxy ended in after this test.
  status            ProxyServerStatus
  statusMessage     String?
  // Elapsed time of the attempt, also for a failed one.
  latencyMs         Int?
  requestMethod     String
  requestUrl        String
  requestHeaders    Json
  requestBody       String?
  // Null when no response arrived (connection refused, timeout).
  responseStatus    Int?
  responseHeaders   Json?
  responseBody      String?
  responseTruncated Boolean           @default(false)
  error             String?

  @@index([proxyServerId, testedAt])
  @@index([testedAt])
}

enum SpiderSessionKind {
  // The spider signs in to check an account's credentials.
  VALIDATE_ACCOUNT
  // The spider opens its browser through a proxy and checks whether bot detection pages take it for a person.
  BROWSER_TEST
  // Any task of the standard contract (.plan/spider-task-framework.md). Which task is in SpiderSession.task, so a new task
  // never needs a new value here.
  TASK
  // Reserved: scrape tasks join when brain starts creating them.
  SCRAPE
}

enum SpiderSessionStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

// One run of the spider for one of the user's LinkedIn accounts, shown on /sessions. Its id is the id of the command
// the spider received (the validation id), so a session and its validation share one id. Holds no secret: the
// proxy is kept as a snapshot without credentials, because proxies can be edited or removed later.
model SpiderSession {
  id                String                  @id
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedInAccountId String
  linkedInAccount   LinkedInAccount         @relation(fields: [linkedInAccountId], references: [id], onDelete: Cascade)
  kind              SpiderSessionKind
  status            SpiderSessionStatus     @default(IN_PROGRESS)
  // The spider's verdict: VALID, INVALID_CREDENTIALS, NEEDS_REAUTH or ERROR for an account check; NOT_DETECTED,
  // DETECTED, COULD_NOT_TELL or ERROR for a browser test. Null while in progress.
  outcome           String?
  // One short, fixed sentence from the spider (or brain when the task could not be queued).
  message           String?
  proxyServerId     String?
  proxyServer       ProxyServer?            @relation(fields: [proxyServerId], references: [id], onDelete: SetNull)
  proxyProtocol     ProxyProtocol?
  proxyHost         String?
  proxyPort         Int?
  proxyCountry      String?
  // What the run was given, as a small fixed non-secret object (see SpiderSessionService).
  requestParams     Json
  startedAt         DateTime                @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  // Where the recording lives in the bucket; null when nothing was recorded.
  recordingPrefix   String?
  // The standard contract's fields; null for sessions made before it.
  task              String?
  taskVersion       Int?
  // manual, automatic or retry.
  trigger           String?
  // The task's own verdict code (also copied to `outcome`), which brain stores and never interprets.
  verdict           String?
  // The task's own readable report, shown as text.
  report            Json?
  // Git sha of the worker that ran it, to reproduce a run.
  workerBuild       String?
  artifacts         SpiderSessionArtifact[]
  // The session this one is a retry of.
  retryOfId         String?
  retryOf           SpiderSession?          @relation("SessionRetries", fields: [retryOfId], references: [id], onDelete: SetNull)
  retries           SpiderSession[]         @relation("SessionRetries")
  // Present only while the task waits to be published (.plan/task-outbox.md).
  dispatch          TaskDispatch?
  // Present for a finished `linkedin-messages` run whose messages are stored (.plan/unibox-backend.md).
  messageImport     MessageImport?
  // Present for a finished `linkedin-profile` run whose profile is stored (.plan/account-profile-backend.md).
  profileImport     ProfileImport?
  // Present for a finished `linkedin-invitations` run whose requests are stored (.plan/my-network-invitations.md).
  invitationImport  InvitationImport?
  inviteImport      InviteImport?
  // The connection requests this run was asked to answer.
  invitations       LinkedInInvitation[]
  // Present for a finished `linkedin-connections` run whose connections are stored (.plan/my-connections.md).
  connectionImport  ConnectionImport?
  // The connection this run was asked to remove.
  connections       LinkedInConnection[]

  @@index([userId, startedAt])
  @@index([userId, status, startedAt])
  @@index([userId, task, startedAt])
  @@index([userId, trigger, startedAt])
  @@index([linkedInAccountId, startedAt])
  @@index([task, proxyServerId, startedAt])
}

// One file of a run in the bucket. `path` is checked against the folder brain computes for the run before it is saved, so a
// result can never point at another user's files.
model SpiderSessionArtifact {
  id          String        @id @default(uuid(7))
  sessionId   String
  session     SpiderSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // log, network, timeline, video, screenshot, report, session or file.
  kind        String
  name        String
  path        String
  contentType String
  bytes       Int
  // The recorded step a screenshot belongs to.
  step        Int?
  // Holds login tokens: shown to the owner only on request.
  sensitive   Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@unique([sessionId, path])
  @@index([sessionId])
}

// A task that was accepted and waits to be published to RabbitMQ (.plan/task-outbox.md). It holds no secret: the command is
// built from the session, the account and the proxy when it is published. The row is deleted once the broker confirmed it.
model TaskDispatch {
  sessionId      String        @id
  session        SpiderSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  attempts       Int           @default(0)
  nextAttemptAt  DateTime      @default(now())
  // A lease, so two publishers never take the same row.
  claimedUntil   DateTime?
  // Counts failed attempts to end the session after the age limit; after three the session is ended without its hook.
  giveUpFailures Int           @default(0)
  // A fixed sentence or an error class, never message content.
  lastError      String?

  @@index([nextAttemptAt])
}

// What the worker announced about a task (title, verdict labels, what it needs, how often it may run), so brain and the web
// app know every task without importing spider code.
model TaskDefinition {
  task     String
  version  Int
  manifest Json
  seenAt   DateTime @default(now())

  @@id([task, version])
}

enum ConversationKind {
  DIRECT
  GROUP
}

enum MessageDirection {
  // Sent from the LinkedIn account.
  ME
  // Sent by someone else in the conversation.
  THEM
}

// A conversation of one LinkedIn account, as the spider read it (.plan/unibox-backend.md). Other people's words: kept only for the
// owner of the account, deleted with the account. `readAt` and `doneAt` are the owner's own marks in the Unibox, not LinkedIn's.
model LinkedInConversation {
  id                String            @id @default(uuid(7))
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  account           LinkedInAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // The id in the address of the conversation page on LinkedIn.
  linkedInId        String
  title             String
  kind              ConversationKind
  // The people other than the account: name, profileUrl and imageUrl as the page showed them.
  participants      Json
  // The profile link of the first participant, to find the same person in other accounts.
  contactProfileUrl String?
  // What its row in the list was known by when it was last read (`rowHash` of the spider); the next read leaves a row with the same
  // value alone.
  rowHash           String?
  // Unread in the Unibox: LinkedIn's mark when the spider opened the conversation, then the owner's own (`readAt` is when they cleared it).
  unread            Boolean
  // False when only part of the conversation was read: older messages are missing.
  complete          Boolean
  messageCount      Int               @default(0)
  lastMessageAt     DateTime?
  lastDirection     MessageDirection?
  // Times of messages are the wall-clock LinkedIn showed (the account's own day), kept as if UTC: only their order and the time
  // of day are true, never compare them with the real clock. The first of their messages after the last one of the account, and the account's last message.
  waitingSince      DateTime?
  lastReplyAt       DateTime?
  readAt            DateTime?
  doneAt            DateTime?
  // The number of messages when the owner closed it without replying; it is done only while no message came after.
  doneMessageCount  Int?
  importedAt        DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  messages          LinkedInMessage[]
  replies           LinkedInReply[]

  @@unique([accountId, linkedInId])
  @@index([userId, lastMessageAt])
  @@index([userId, contactProfileUrl])
}

model LinkedInMessage {
  id               String               @id @default(uuid(7))
  conversationId   String
  conversation     LinkedInConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // LinkedIn's own id of the message, or the stable one the reader made when the page showed none.
  linkedInId       String
  direction        MessageDirection
  senderName       String
  senderProfileUrl String?
  // The wall-clock of LinkedIn, as if UTC (see LinkedInConversation); a message with none is placed a minute after the one before.
  sentAt           DateTime?
  // The time as LinkedIn showed it ("Jan 25, 2024 5:18 PM").
  whenText         String
  text             String
  attachments      Json
  // The order in the conversation, oldest first.
  position         Int
  createdAt        DateTime             @default(now())

  @@unique([conversationId, linkedInId])
  @@index([conversationId, position])
}

enum MessageImportStatus {
  PENDING
  DONE
  FAILED
}

// A finished `linkedin-messages` run that waits to be stored (.plan/unibox-backend.md). Made in the transaction that finishes the
// session; a worker job reads the run's files and stores them. It holds no message text.
model MessageImport {
  sessionId     String              @id
  session       SpiderSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status        MessageImportStatus @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  // A lease, so two workers never take the same row.
  claimedUntil  DateTime?
  // A fixed sentence or an error class, never message content.
  lastError     String?
  createdAt     DateTime            @default(now())
  importedAt    DateTime?

  @@index([status, nextAttemptAt])
}

// A finished `linkedin-profile` run that waits to be stored (.plan/account-profile-backend.md); the same shape and lifecycle as
// MessageImport, so it uses the same status. It holds no profile content.
model ProfileImport {
  sessionId     String              @id
  session       SpiderSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status        MessageImportStatus @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  // A lease, so two workers never take the same row.
  claimedUntil  DateTime?
  // A fixed sentence or an error class, never profile content.
  lastError     String?
  createdAt     DateTime            @default(now())
  importedAt    DateTime?

  @@index([status, nextAttemptAt])
}

// A LinkedIn login whose account was deleted after its first day (.plan/first-day-reads.md): kept 30 days so the same login added again
// gets its first reads but not a second night allowance. Only a hash of the lowercased login, never the login itself.
model FirstDayUsed {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginHash String
  usedAt    DateTime @default(now())

  @@id([userId, loginHash])
  @@index([usedAt])
}

// The latest profile read for an account, as the contract `accountProfileSchema` has it. One row per account: a new read replaces
// it. It holds the owner's contact info and other people's names and texts, so it is only ever served to the owner and goes with
// the account.
model LinkedInAccountProfile {
  accountId  String          @id
  account    LinkedInAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  data       Json
  // When the spider read it (the file's own time), and when brain stored it.
  capturedAt DateTime
  importedAt DateTime        @default(now())
  // The run it came from.
  sessionId  String

  @@index([userId])
}

enum JobRunOutcome {
  // Did something.
  WORKED
  // Ran and found nothing due.
  IDLE
  FAILED
  TIMED_OUT
}

enum JobItemResult {
  ASKED
  SKIPPED
  FAILED
}

// What the brain worker announced about each scheduled job at start (.plan/cron-monitor.md), so the admin page knows every
// job, also one that has not run yet.
model JobDefinition {
  name      String   @id
  title     String
  purpose   String
  everyMs   Int
  timeoutMs Int
  seenAt    DateTime @default(now())
}

// One run of a scheduled job of the brain worker, idle ones too, kept 30 days. No text of any message and no secret.
model JobRun {
  id         String        @id
  job        String
  startedAt  DateTime
  finishedAt DateTime
  durationMs Int
  outcome    JobRunOutcome
  summary    String?
  counts     Json?
  // The class and a short message with credentials masked; never a stack.
  error      String?
  instance   String
  build      String
  items      JobRunItem[]

  @@index([job, startedAt])
  @@index([startedAt])
}

// What a run handled: one user's account and what was done or why it was left. Ids only, no foreign keys, so the history
// outlives a deleted account.
model JobRunItem {
  id        String        @id @default(uuid(7))
  runId     String
  run       JobRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId    String?
  accountId String?
  action    String
  result    JobItemResult
  // A fixed sentence.
  reason    String?
  // The task session the run started.
  sessionId String?

  @@index([runId])
}

enum LinkedInReplyState {
  // Asked for and waiting its turn: the account is sending another reply (.plan/reply-queue.md).
  QUEUED
  SENDING
  SENT
  FAILED
  UNKNOWN
}

// A reply the owner wrote in the Unibox, typed into the account's own LinkedIn page by the `linkedin-reply` task
// (.plan/unibox-send.md). The text is the owner's own words, kept for the owner and deleted with the account. `UNKNOWN` means
// send was pressed and the page did not show the message, so it may have gone. A partial unique index (see the migration) allows
// one `SENDING` reply per account.
model LinkedInReply {
  id             String                @id @default(uuid(7))
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId      String
  account        LinkedInAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Empty for a first message to a connection (.plan/message-connections.md) until the run's conversation is stored.
  conversationId String?
  conversation   LinkedInConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // A first message: the connection's profile address after /in/ and their name, as the task is told them.
  recipientSlug  String?
  recipientName  String?
  // May be empty when the reply is files only.
  text           String
  // The files that go with it (name, kind, bytes). They wait under uploads/ until the reply ends, then are moved for good to
  // kept/<user>/<account>/sent/<upload>/ and never deleted (.plan/unibox-keep-messages-and-files.md).
  attachments    Json                  @default("[]")
  uploadId       String?
  // Set once the files were moved to their permanent place.
  filesKeptAt    DateTime?
  // Set when the message LinkedIn showed for this reply was stored and given these files.
  matchedAt      DateTime?
  // Set when the owner dismissed a reply that did not go, so the page stops showing it after a reload.
  dismissedAt    DateTime?
  state          LinkedInReplyState    @default(SENDING)
  // A fixed sentence the owner can read, set when the reply did not go.
  failure        String?
  // The spider run that types it; the run may be deleted before the reply. Empty while the reply is queued.
  sessionId      String?               @unique
  createdAt      DateTime              @default(now())
  // When its run was asked for; the quiet time between two replies of an account counts from it.
  startedAt      DateTime?
  sentAt         DateTime?
  // Why a queued reply has not started and the earliest it may (the account is resting, outside its working hours, out of browsing time),
  // and the zone of the account's working hours; set by brain, cleared when it starts (.plan/reply-wait-for-rest.md).
  waitReason     String?
  waitUntil      DateTime?
  waitZone       String?

  @@index([accountId, createdAt])
  @@index([accountId, startedAt])
  @@index([conversationId, createdAt])
  @@index([state, createdAt])
  @@index([accountId, recipientSlug])
}

enum LinkedInInvitationStatus {
  // Waits for the owner.
  PENDING
  // Asked for, in a run that is going.
  QUEUED
  ACCEPTED
  IGNORED
  // Not on LinkedIn any more (withdrawn, or answered elsewhere).
  GONE
  // The run ended without clicking it; the sentence is in `failure`.
  FAILED
  // It was clicked and LinkedIn did not show whether it took.
  UNKNOWN
}

enum LinkedInInvitationAction {
  ACCEPT
  IGNORE
}

// A connection request an account received, as the `linkedin-invitations` task read it (.plan/my-network-invitations.md). Holds
// what the sender made public or wrote to the owner (name, headline, note, photo address), kept for the owner and deleted with the
// account; there is no retention policy yet (an open item in MEMORY.md). `linkedInId` is LinkedIn's own number for the request and
// never reaches the browser: the page uses `id`.
model LinkedInInvitation {
  id         String                    @id @default(uuid(7))
  userId     String
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String
  account    LinkedInAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  linkedInId String
  slug       String
  name       String
  headline   String
  mutual     String?
  note       String?
  photoUrl   String?
  // Where it was in the last read that listed it, so the page keeps LinkedIn's order.
  position   Int                       @default(0)
  status     LinkedInInvitationStatus  @default(PENDING)
  action     LinkedInInvitationAction?
  // The run that was asked to answer it; the run may be deleted before the request.
  sessionId  String?
  session    SpiderSession?            @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  // A fixed sentence the owner can read, set when the run ended without answering it.
  failure    String?
  seenAt     DateTime                  @default(now())
  startedAt  DateTime?
  answeredAt DateTime?
  goneAt     DateTime?
  createdAt  DateTime                  @default(now())

  @@unique([accountId, linkedInId])
  @@index([accountId, status])
  @@index([sessionId])
  @@index([status, startedAt])
  @@index([userId, slug])
}

// A finished `linkedin-invitations` run that waits to be stored; the same shape and lifecycle as MessageImport. It holds no names.
model InvitationImport {
  sessionId     String              @id
  session       SpiderSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status        MessageImportStatus @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  claimedUntil  DateTime?
  // An error class, never page content.
  lastError     String?
  createdAt     DateTime            @default(now())
  importedAt    DateTime?

  @@index([status, nextAttemptAt])
}

enum LinkedInConnectionStatus {
  // On the list of the account at the last read.
  CONNECTED
  // Remove was asked for, in a run that is going.
  REMOVING
  // Remove was pressed and the connection left the list.
  REMOVED
  // Not on the list any more (removed by the other side or on LinkedIn), or it was not there when the removal ran.
  GONE
  // Remove was pressed and the page did not say what came of it.
  UNKNOWN
  // The run ended without removing it; the sentence is in `failure`.
  FAILED
}

// A connection of an account, as the `linkedin-connections` task read it (.plan/my-connections.md). Holds what the member made public
// (name, headline, photo address) and the day they connected, kept for the owner and deleted with the account; there is no retention
// policy yet (an open item in MEMORY.md). `slug` is the part of the member's profile address after /in/.
model LinkedInConnection {
  id          String                   @id @default(uuid(7))
  userId      String
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     LinkedInAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  headline    String
  // The day they connected, when the page said it in words that could be read.
  connectedOn DateTime?
  photoUrl    String?
  // LinkedIn's own number of the member, to open its message window.
  messageUrn  String?
  // Where it was in the last read that listed it, so the page keeps LinkedIn's order (most recent first).
  position    Int                      @default(0)
  status      LinkedInConnectionStatus @default(CONNECTED)
  // The run that was asked to remove it; the run may be deleted before the connection.
  sessionId   String?
  session     SpiderSession?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  // A fixed sentence the owner can read, set when the run ended without removing it.
  failure     String?
  seenAt      DateTime                 @default(now())
  startedAt   DateTime?
  removedAt   DateTime?
  goneAt      DateTime?
  createdAt   DateTime                 @default(now())

  @@unique([accountId, slug])
  @@index([accountId, status])
  @@index([sessionId])
  @@index([status, startedAt])
  @@index([userId, slug])
}

// A finished `linkedin-connections` run that waits to be stored; the same shape and lifecycle as InvitationImport. It holds no names.
model ConnectionImport {
  sessionId     String              @id
  session       SpiderSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status        MessageImportStatus @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  claimedUntil  DateTime?
  // An error class, never page content.
  lastError     String?
  createdAt     DateTime            @default(now())
  importedAt    DateTime?

  @@index([status, nextAttemptAt])
}

// A post the owner is writing for one of their own LinkedIn accounts (.plan/posting-page.md). It is always a draft: nothing sends
// it yet. `blocks` follows the contract `postBlocksSchema` (text, one attachment); files are never stored, only their name,
// size and alt text. `plannedAt` is the time the owner chose, in `plannedZone`. The owner's own words, so it is only ever served
// to the owner and goes with the account.
model PostDraft {
  id          String          @id @default(uuid(7))
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     LinkedInAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  blocks      Json            @default("[]")
  // Who can see the post and who can comment on it.
  audience    PostVisibility  @default(ANYONE)
  comments    PostVisibility  @default(ANYONE)
  plannedAt   DateTime?
  plannedZone String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, updatedAt])
  @@index([accountId])
}

enum PostVisibility {
  ANYONE
  CONNECTIONS
}

enum PostPublicationState {
  // Chosen to go out at `scheduledAt`; the post-send job queues it when it is due.
  SCHEDULED
  // Asked for and waiting its turn: the account is busy, or its start is not yet allowed.
  QUEUED
  SENDING
  POSTED
  FAILED
  // Post was pressed and LinkedIn never said it went, so it may have.
  UNKNOWN
}

// A post that was sent for posting or is planned (.plan/posting-send-task.md). It is the frozen copy of a draft: the blocks as they
// were when the owner pressed Post now or Schedule, so a later edit of the draft changes nothing here. The owner's own words, only
// served to the owner and gone with the account. A partial unique index (see the migration) allows one `SENDING` post per account.
model PostPublication {
  id             String               @id @default(uuid(7))
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId      String
  account        LinkedInAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  blocks         Json                 @default("[]")
  audience       PostVisibility       @default(ANYONE)
  comments       PostVisibility       @default(ANYONE)
  state          PostPublicationState
  // When it is to start (scheduled), in the zone the owner chose; empty for a post sent now.
  scheduledAt    DateTime?
  plannedZone    String?
  // A fixed sentence the owner can read, set when it did not go or went without a link.
  failure        String?
  // The address of the post on LinkedIn, only ever one that passed the contract's check.
  link           String?
  // The spider run that makes it; empty while it waits.
  sessionId      String?              @unique
  createdAt      DateTime             @default(now())
  // When its run was asked for; the quiet time between two posts of an account counts from it.
  startedAt      DateTime?
  postedAt       DateTime?
  // Set once the files of a post that went were deleted from the bucket.
  filesDeletedAt DateTime?
  // The run and block of a workflow that made this post; empty for a post sent from the Posting page. The block keeps the files.
  runId          String?
  nodeId         String?
  // Why a queued post has not started, and the earliest it may be asked for again; set by the post-send job and cleared when it starts.
  waitReason     String?
  waitUntil      DateTime?
  waitZone       String?

  @@index([userId, createdAt])
  @@index([accountId, state])
  @@index([state, scheduledAt])
  @@index([runId, nodeId])
}

enum CdnFileStatus {
  SAVED
  // One call is fetching it; another call may take it over once it is stale.
  PENDING
  DELETED
}

// A copy of a public remote file kept in the public cdn bucket (.plan/cdn-public-endpoint.md). `hash` is the MD5 of `path`, the
// normalised remote URL. `bucketUrl` (gs://<bucket>/<key>) never changes once set, so a redirect a browser cached stays right.
model CdnFile {
  id          String        @id @default(uuid(7))
  hash        String        @unique
  path        String
  status      CdnFileStatus @default(SAVED)
  bucketUrl   String?
  contentType String?
  size        Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Who the owner works for (.plan/network-hub.md). Every account, list and target belongs to one; null on those rows means the
// owner's default client, the one with `isDefault`, created on first use.
model Client {
  id        String            @id @default(uuid(7))
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean           @default(false)
  // When the owner last left My network on this client; people first seen after it are new.
  seenAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  accounts  LinkedInAccount[]
  lists     WorkflowList[]
  profiles  LinkedInProfile[]
  people    Person[]
  invites   LinkedInInvite[]

  @@unique([userId, name])
}

enum PersonStatus {
  NEW
  // Set when one of the client's accounts messaged them.
  CONTACTED
  // Set when they wrote back.
  REPLIED
  NOT_INTERESTED
  DONE
}

enum PersonFit {
  STRONG
  MAYBE
  NONE
}

enum PersonLinkKind {
  REQUEST
  CONNECTION
  CONVERSATION
  LIST_MEMBER
  TARGET
  INVITE
}

// One person of one client on My network (.plan/network-hub.md), built by the people-index job from the rows that tie them to the
// client (`PersonLink`). Status, labels, notes and Do not contact are the client's own and survive a rebuild. `search` is a
// generated full-text column (see the migration).
model Person {
  id             String                   @id @default(uuid(7))
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // The profile's public identifier from linkedin.com/in/<slug>, as the rows have it.
  slug           String
  name           String?
  headline       String?
  company        String?
  photoUrl       String?
  status         PersonStatus             @default(NEW)
  // Set when the owner chose the status; the index never moves a chosen Not interested or Done.
  statusSetAt    DateTime?
  labels         String[]
  notes          String?
  doNotContact   Boolean                  @default(false)
  fit            PersonFit                @default(NONE)
  score          Int?
  // Why they are here, in one line: what brought them in, their own words when there are some, a link, and when.
  reasonKind     PersonLinkKind?
  reasonText     String?
  reasonUrl      String?
  reasonAt       DateTime?
  // `request`, `connection`, `target`, or `list:<id>`, for the Found by filter.
  foundBy        String[]
  // 2: a reply waits, 1: a request waits, 0: nothing waits on the client.
  priority       Int                      @default(0)
  // The client wrote last and no answer came yet.
  waiting        Boolean                  @default(false)
  lastTouchAt    DateTime
  firstSeenAt    DateTime                 @default(now())
  // For the filters (.plan/network-filters.md), kept by the index. Title and country come from the newest profile read.
  title          String?
  country        String?
  // The current company's LinkedIn slug from the newest read; it is also saved to the owner's /companies.
  companySlug    String?
  // The skills of the newest profile read, as LinkedIn wrote them, for the Skills filter.
  skills         String[]
  // Null until a read or an account's visit says.
  premium        Boolean?
  profileRead    Boolean                  @default(false)
  // The earliest connection of the client's accounts that still holds; null when not connected.
  connectedAt    DateTime?
  // The newest message of the client's accounts to them, and theirs to the accounts (LinkedIn's wall-clock, see LinkedInConversation).
  lastSentAt     DateTime?
  lastReceivedAt DateTime?
  inviteState    PersonInviteState        @default(NONE)
  // Prisma reads a generated column's expression as its default; written as Postgres prints it, so `migrate dev` sees no change.
  search         Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, ((((((COALESCE(name, ''::text) || ' '::text) || COALESCE(headline, ''::text)) || ' '::text) || COALESCE(company, ''::text)) || ' '::text) || slug))"))
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  links          PersonLink[]

  @@unique([clientId, slug])
  @@index([clientId, priority, lastTouchAt, id])
  @@index([clientId, waiting, lastTouchAt, id])
  @@index([clientId, lastTouchAt, id])
  @@index([clientId, firstSeenAt])
  @@index([userId, slug])
  @@index([userId, companySlug])
  @@index([foundBy], type: Gin)
  @@index([labels], type: Gin)
  @@index([skills], type: Gin)
  @@index([search], map: "Person_search_idx", type: Gin)
  @@index([clientId, country])
  @@index([clientId, connectedAt])
  @@index([clientId, lastSentAt])
  @@index([clientId, lastReceivedAt])
}

// Where the newest invite of the client to a person stands: QUEUED (not sent yet), PENDING (sent, no answer), ACCEPTED, or
// ENDED (withdrawn or failed).
enum PersonInviteState {
  NONE
  QUEUED
  PENDING
  ACCEPTED
  ENDED
}

// One row that ties a person to a client: the request, connection or conversation of an account, the list member or the target.
model PersonLink {
  id        String           @id @default(uuid(7))
  personId  String
  person    Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  accountId String?
  account   LinkedInAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      PersonLinkKind
  sourceId  String
  at        DateTime

  @@unique([personId, kind, sourceId])
  @@index([accountId, personId])
  @@index([sourceId])
}

// The profiles whose people must be rebuilt. Filled by database triggers on every row that ties a profile to the owner (see the
// migration add_network_hub), emptied by the people-index job.
model PeopleIndexDirty {
  userId    String
  slug      String
  createdAt DateTime @default(now())

  @@id([userId, slug])
  @@index([createdAt])
}

// One export of My network: who, which client, how many rows, and whether it was refused. No personal data.
model PeopleExport {
  id        String   @id @default(uuid(7))
  userId    String
  clientId  String
  rows      Int
  refused   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// One erasure of a person: who asked and when, nothing about the person, so it can be quoted back to them.
model PersonErasure {
  id        String   @id @default(uuid(7))
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum LinkedInInviteState {
  // Waits for its planned day and its account's turn.
  QUEUED
  // In a run that is going.
  SENDING
  SENT
  ACCEPTED
  // Pending too long: waits for a run that withdraws it, then in that run.
  WITHDRAW_QUEUED
  WITHDRAWING
  WITHDRAWN
  // Not sent; the sentence is in `reason`.
  FAILED
  // Send may have been pressed and LinkedIn did not say; counted as sent and never sent again.
  UNKNOWN
  // Refused when it was asked for (do not contact, already connected, invited recently); the sentence is in `reason`.
  SKIPPED
  // The owner took it back before it went.
  CANCELLED
}

// A connection invite one account of a client sends (.plan/network-invites.md). The note is the owner's own words, filled in when
// it was asked for, kept for the owner and deleted with the account. A partial unique index (see the migration) allows one live
// invite per client and person.
model LinkedInInvite {
  id          String              @id @default(uuid(7))
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accountId   String
  account     LinkedInAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  slug        String
  // LinkedIn's own number of the member, from the Connect button.
  memberId    String?
  name        String
  note        String?
  // The Found by source that led to it (`request`, `connection`, `target`, `list:<id>`), credited with an accept.
  source      String?
  state       LinkedInInviteState @default(QUEUED)
  // A fixed sentence the owner can read: why it was skipped, failed or withdrawn.
  reason      String?
  // The earliest it may go, as planned when it was asked for (20 a day, 100 a week per account).
  plannedAt   DateTime
  // Runs that did not get to it; after a few it fails.
  tries       Int                 @default(0)
  // The run that sends or withdraws it; the run may be deleted before the invite.
  sessionId   String?
  // Why it has not started and the earliest it may (the account resting, outside its hours), and the zone of its hours.
  waitReason  String?
  waitUntil   DateTime?
  waitZone    String?
  createdAt   DateTime            @default(now())
  // When its send run was asked for; the account's limits count from it.
  startedAt   DateTime?
  invitedAt   DateTime?
  acceptedAt  DateTime?
  withdrawnAt DateTime?

  @@index([accountId, state, plannedAt])
  @@index([accountId, startedAt])
  @@index([clientId, slug])
  @@index([clientId, invitedAt])
  @@index([userId, slug])
  @@index([sessionId])
  @@index([state, invitedAt])
}

// A finished `linkedin-invite` run that waits to be stored; the same shape and lifecycle as InvitationImport. It holds no names.
model InviteImport {
  sessionId     String              @id
  session       SpiderSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status        MessageImportStatus @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  claimedUntil  DateTime?
  // An error class, never page content.
  lastError     String?
  createdAt     DateTime            @default(now())
  importedAt    DateTime?

  @@index([status, nextAttemptAt])
}
